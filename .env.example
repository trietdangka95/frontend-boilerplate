# Required in deployed environments. Local development falls back to http://localhost:3000/api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Derived from NODE_ENV when omitted. Use staging/production when deploying.
# NEXT_PUBLIC_APP_ENV=development

# Local-only demo authentication. Always disabled by the production runtime.
ENABLE_DEMO_AUTH=false

# Only required when enabling the local demo. Generate a unique value with at least 32 characters.
DEMO_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
