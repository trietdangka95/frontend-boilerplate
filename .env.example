# Required in deployed environments. Local development falls back to http://localhost:3000/api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: development, test, staging, or production. Defaults to development.
NEXT_PUBLIC_APP_ENV=development

# Server-only. Keep refresh tokens in HTTP-only cookies; do not expose this as NEXT_PUBLIC_*.
API_REFRESH_ENDPOINT=/auth/refresh
